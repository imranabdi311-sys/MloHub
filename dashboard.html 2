<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>MloHub Restaurant Dashboard</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: linear-gradient(135deg, #ff6500, #ff9d00);
      color: white;
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
    }

    .logo {
      font-size: 28px;
      font-weight: 900;
    }

    .dashboard-title {
      font-size: 14px;
      opacity: .9;
    }

    .container {
      width: 94%;
      max-width: 1300px;
      margin: 25px auto;
    }

    .top-card {
      background: white;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,.06);
      margin-bottom: 25px;
    }

    .top-card h2 {
      margin-bottom: 15px;
    }

    select {
      width: 100%;
      max-width: 450px;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 16px;
      background: white;
    }

    .dashboard-actions {
      margin-top: 15px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      cursor: pointer;
      border-radius: 8px;
      font-weight: bold;
    }

    .refresh-btn {
      background: #222;
      color: white;
      padding: 11px 18px;
    }

    .back-btn {
      background: #eee;
      color: #222;
      padding: 11px 18px;
      text-decoration: none;
      display: inline-block;
      border-radius: 8px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: white;
      padding: 20px;
      border-radius: 14px;
      box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

    .stat-card span {
      color: #777;
      font-size: 14px;
    }

    .stat-card strong {
      display: block;
      font-size: 28px;
      margin-top: 8px;
      color: #ff6500;
    }

    .orders-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      gap: 10px;
      flex-wrap: wrap;
    }

    .orders-header h2 {
      font-size: 24px;
    }

    .last-updated {
      color: #777;
      font-size: 13px;
    }

    .orders {
      display: grid;
      gap: 18px;
    }

    .order-card {
      background: white;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,.07);
      border-left: 5px solid #ff6500;
    }

    .order-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .order-number {
      font-size: 20px;
      font-weight: bold;
    }

    .order-time {
      color: #777;
      font-size: 13px;
      margin-top: 5px;
    }

    .status {
      padding: 7px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      text-transform: capitalize;
      height: fit-content;
    }

    .status-pending {
      background: #fff0d8;
      color: #c56b00;
    }

    .status-accepted {
      background: #e6f0ff;
      color: #1769aa;
    }

    .status-preparing {
      background: #eee6ff;
      color: #6c36a8;
    }

    .status-ready {
      background: #e4f8ea;
      color: #17833b;
    }

    .status-assigned {
      background: #e4f8f7;
      color: #087b76;
    }

    .status-picked_up {
      background: #e4f0ff;
      color: #1769aa;
    }

    .status-delivered {
      background: #dff7e5;
      color: #08752a;
    }

    .status-cancelled {
      background: #ffe4e4;
      color: #b00020;
    }

    .order-details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }

    .detail-box {
      background: #f8f8f8;
      padding: 13px;
      border-radius: 9px;
    }

    .detail-box small {
      display: block;
      color: #777;
      margin-bottom: 5px;
    }

    .detail-box strong {
      word-break: break-word;
    }

    .items {
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 15px 0;
      margin-bottom: 18px;
    }

    .items h3 {
      margin-bottom: 10px;
    }

    .item-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding: 7px 0;
    }

    .total {
      font-size: 21px;
      font-weight: bold;
      color: #ff6500;
      margin-bottom: 18px;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .actions button,
    .actions a {
      padding: 10px 14px;
      text-decoration: none;
      display: inline-block;
      color: white;
      border-radius: 8px;
      font-size: 14px;
    }

    .accept {
      background: #1769aa;
    }

    .preparing {
      background: #6c36a8;
    }

    .ready {
      background: #16833b;
    }

    .assigned {
      background: #087b76;
    }

    .picked {
      background: #1769aa;
    }

    .delivered {
      background: #08752a;
    }

    .cancel {
      background: #c62828;
    }

    .call {
      background: #222;
    }

    .whatsapp {
      background: #25D366;
    }

    .loading,
    .empty,
    .error {
      background: white;
      padding: 35px;
      text-align: center;
      border-radius: 12px;
      color: #777;
    }

    .error {
      color: #b00020;
    }

    @media (max-width: 600px) {
      .order-card {
        padding: 15px;
      }

      .order-number {
        font-size: 18px;
      }
    }
  </style>
</head>

<body>

<header>

  <div>
    <div class="logo">MloHub</div>
    <div class="dashboard-title">
      Restaurant Dashboard
    </div>
  </div>

  <a
    href="index.html"
    style="
      color:white;
      text-decoration:none;
      background:rgba(255,255,255,.2);
      padding:10px 15px;
      border-radius:8px;
    "
  >
    ← Customer Site
  </a>

</header>


<main class="container">

  <!-- RESTAURANT SELECTOR -->

  <div class="top-card">

    <h2>Select Restaurant</h2>

    <select
      id="restaurantSelect"
      onchange="restaurantChanged()"
    >
      <option value="">
        Loading restaurants...
      </option>
    </select>

    <div class="dashboard-actions">

      <button
        class="refresh-btn"
        onclick="loadOrders()"
      >
        🔄 Refresh Orders
      </button>

      <a
        href="index.html"
        class="back-btn"
      >
        Order Food
      </a>

    </div>

  </div>


  <!-- STATS -->

  <div
    class="stats"
    id="stats"
    style="display:none;"
  >

    <div class="stat-card">
      <span>New Orders</span>
      <strong id="pendingCount">0</strong>
    </div>

    <div class="stat-card">
      <span>Preparing</span>
      <strong id="preparingCount">0</strong>
    </div>

    <div class="stat-card">
      <span>Ready</span>
      <strong id="readyCount">0</strong>
    </div>

    <div class="stat-card">
      <span>Today's Orders</span>
      <strong id="todayCount">0</strong>
    </div>

  </div>


  <!-- ORDERS -->

  <div class="orders-header">

    <h2>Orders</h2>

    <div
      class="last-updated"
      id="lastUpdated"
    >
      Not loaded yet
    </div>

  </div>

  <div
    id="orders"
    class="orders"
  >

    <div class="empty">
      Select a restaurant to view orders.
    </div>

  </div>

</main>


<script>

  /* =====================================
     SUPABASE
  ===================================== */

  const SUPABASE_URL =
    "https://bhvzpycbztngtwuhxxex.supabase.co";

  const SUPABASE_ANON_KEY =
    "sb_publishable_nt_lF05XbdQtINzqOpdT8g_mJH-8aCq";

  const supabaseClient =
    supabase.createClient(
      SUPABASE_URL,
      SUPABASE_ANON_KEY
    );


  /* =====================================
     VARIABLES
  ===================================== */

  let restaurants = [];

  let currentRestaurantId = null;

  let currentOrders = [];


  /* =====================================
     START
  ===================================== */

  document.addEventListener(
    "DOMContentLoaded",
    loadRestaurants
  );


  /* =====================================
     LOAD RESTAURANTS
  ===================================== */

  async function loadRestaurants() {

    const select =
      document.getElementById(
        "restaurantSelect"
      );

    select.innerHTML =
      `<option value="">
        Loading restaurants...
      </option>`;

    const {
      data,
      error
    } = await supabaseClient
      .from("restaurants")
      .select("*")
      .order("id", {
        ascending: true
      });

    if (error) {

      console.error(error);

      select.innerHTML =
        `<option value="">
          Error loading restaurants
        </option>`;

      document.getElementById(
        "orders"
      ).innerHTML =
        `<div class="error">
          ${escapeHtml(error.message)}
        </div>`;

      return;
    }

    restaurants = data || [];


    if (!restaurants.length) {

      select.innerHTML =
        `<option value="">
          No restaurants found
        </option>`;

      return;
    }


    select.innerHTML =
      `<option value="">
        Select restaurant...
      </option>` +
      restaurants.map(
        restaurant => `
          <option value="${restaurant.id}">
            ${escapeHtml(
              restaurant.name || "Restaurant"
            )}
          </option>
        `
      ).join("");


    /*
      Automatically select first
      restaurant for easier testing.
    */

    select.value =
      restaurants[0].id;

    currentRestaurantId =
      restaurants[0].id;

    await loadOrders();
  }


  /* =====================================
     RESTAURANT CHANGED
  ===================================== */

  async function restaurantChanged() {

    const select =
      document.getElementById(
        "restaurantSelect"
      );

    currentRestaurantId =
      select.value || null;


    if (!currentRestaurantId) {

      document.getElementById(
        "orders"
      ).innerHTML =
        `<div class="empty">
          Select a restaurant to view orders.
        </div>`;

      document.getElementById(
        "stats"
      ).style.display = "none";

      return;
    }


    await loadOrders();
  }


  /* =====================================
     LOAD ORDERS
  ===================================== */

  async function loadOrders() {

    if (!currentRestaurantId) {

      document.getElementById(
        "orders"
      ).innerHTML =
        `<div class="empty">
          Select a restaurant first.
        </div>`;

      return;
    }


    const ordersContainer =
      document.getElementById(
        "orders"
      );

    ordersContainer.innerHTML =
      `<div class="loading">
        Loading orders...
      </div>`;


    /*
      Get restaurant orders.
    */

    const {
      data: orders,
      error: ordersError
    } =
      await supabaseClient
        .from("orders")
        .select("*")
        .eq(
          "restaurant_id",
          currentRestaurantId
        )
        .order(
          "created_at",
          {
            ascending: false
          }
        );


    if (ordersError) {

      console.error(
        ordersError
      );

      ordersContainer.innerHTML =
        `<div class="error">
          <strong>
            Unable to load orders
          </strong>
          <br><br>
          ${escapeHtml(
            ordersError.message
          )}
        </div>`;

      return;
    }


    currentOrders =
      orders || [];


    /*
      Get order items.
    */

    for (
      const order of currentOrders
    ) {

      order.items =
        await loadOrderItems(
          order.id
        );

    }


    updateStats(
      currentOrders
    );

    renderOrders(
      currentOrders
    );


    document.getElementById(
      "lastUpdated"
    ).textContent =
      "Updated " +
      new Date().toLocaleTimeString(
        "en-KE"
      );
  }


  /* =====================================
     LOAD ORDER ITEMS
  ===================================== */

  async function loadOrderItems(
    orderId
  ) {

    const {
      data: orderItems,
      error
    } =
      await supabaseClient
        .from("order_items")
        .select("*")
        .eq(
          "order_id",
          orderId
        );


    if (error) {

      console.error(
        "Order items error:",
        error
      );

      return [];
    }


    if (!orderItems ||
        !orderItems.length) {

      return [];
    }


    /*
      Load menu item names
      individually.

      This avoids relying on
      an unknown Supabase FK
      relationship.
    */

    for (
      const item of orderItems
    ) {

      const {
        data: menuItem
      } =
        await supabaseClient
          .from("menu_items")
          .select(
            "name"
          )
          .eq(
            "id",
            item.menu_item_id
          )
          .maybeSingle();


      item.menu_name =
        menuItem
          ? menuItem.name
          : "Menu item";
    }


    return orderItems;
  }


  /* =====================================
     RENDER ORDERS
  ===================================== */

  function renderOrders(
    orders
  ) {

    const container =
      document.getElementById(
        "orders"
      );


    if (!orders.length) {

      container.innerHTML =
        `<div class="empty">
          <div style="font-size:40px;">
            📭
          </div>

          <br>

          No orders yet.
        </div>`;

      return;
    }


    container.innerHTML =
      orders.map(
        order =>
          createOrderCard(order)
      ).join("");
  }


  /* =====================================
     ORDER CARD
  ===================================== */

  function createOrderCard(
    order
  ) {

    const status =
      order.order_status ||
      "pending";


    const statusClass =
      "status-" +
      status;


    const orderTime =
      order.created_at
        ? new Date(
            order.created_at
          ).toLocaleString(
            "en-KE"
          )
        : "Unknown";


    const orderType =
      order.order_type ||
      "delivery";


    const payment =
      order.payment_method ||
      "cash";


    const items =
      order.items || [];


    const itemsHtml =
      items.length
        ? items.map(
            item => `

              <div class="item-row">

                <span>
                  ${item.quantity} ×
                  ${escapeHtml(
                    item.menu_name
                  )}
                </span>

                <strong>
                  KSh
                  ${formatMoney(
                    Number(
                      item.price || 0
                    ) *
                    Number(
                      item.quantity || 0
                    )
                  )}
                </strong>

              </div>

            `
          ).join("")
        : `
            <div>
              No items found.
            </div>
          `;


    const phone =
      order.customer_phone || "";


    const cleanPhone =
      phone
        .toString()
        .replace(
          /\D/g,
          ""
        );


    return `

      <div class="order-card">

        <div class="order-top">

          <div>

            <div class="order-number">
              Order #${order.id}
            </div>

            <div class="order-time">
              ${escapeHtml(
                orderTime
              )}
            </div>

          </div>

          <div
            class="status ${statusClass}"
          >
            ${formatStatus(
              status
            )}
          </div>

        </div>


        <div class="order-details">

          <div class="detail-box">

            <small>
              Customer
            </small>

            <strong>
              ${escapeHtml(
                order.customer_name ||
                "Customer"
              )}
            </strong>

          </div>


          <div class="detail-box">

            <small>
              Phone
            </small>

            <strong>
              ${escapeHtml(
                phone ||
                "Not provided"
              )}
            </strong>

          </div>


          <div class="detail-box">

            <small>
              Order Type
            </small>

            <strong>
              ${
                orderType === "pickup"
                  ? "🏪 Pickup"
                  : "🛵 Delivery"
              }
            </strong>

          </div>


          <div class="detail-box">

            <small>
              Payment
            </small>

            <strong>
              ${
                payment === "mpesa"
                  ? "📱 M-Pesa"
                  : "💵 Cash"
              }
            </strong>

          </div>


          <div class="detail-box">

            <small>
              ${
                orderType === "pickup"
                  ? "Collection"
                  : "Delivery Address"
              }
            </small>

            <strong>
              ${escapeHtml(
                order.delivery_address ||
                "Pickup"
              )}
            </strong>

          </div>

        </div>


        <div class="items">

          <h3>
            🍔 Order Items
          </h3>

          ${itemsHtml}

        </div>


        <div class="total">

          Total:
          KSh
          ${formatMoney(
            order.total_amount
          )}

        </div>


        <div class="actions">

          ${status === "pending"
            ? `
              <button
                class="accept"
                onclick="updateOrderStatus(
                  ${order.id},
                  'accepted'
                )"
              >
                ✓ Accept Order
              </button>
            `
            : ""
          }


          ${
            status === "accepted"
              ? `
                <button
                  class="preparing"
                  onclick="updateOrderStatus(
                    ${order.id},
                    'preparing'
                  )"
                >
                  🍳 Start Preparing
                </button>
              `
              : ""
          }


          ${
            status === "preparing"
              ? `
                <button
                  class="ready"
                  onclick="updateOrderStatus(
                    ${order.id},
                    'ready'
                  )"
                >
                  ✓ Food Ready
                </button>
              `
              : ""
          }


          ${
            status === "ready"
              ? `
                <button
                  class="assigned"
                  onclick="updateOrderStatus(
                    ${order.id},
                    'assigned'
                  )"
                >
                  🛵 Assign Driver
                </button>
              `
              : ""
          }


          ${
            status === "assigned"
              ? `
                <button
                  class="picked"
                  onclick="updateOrderStatus(
                    ${order.id},
                    'picked_up'
                  )"
                >
                  🛵 Picked Up
                </button>
              `
              : ""
          }


          ${
            status === "picked_up"
              ? `
                <button
                  class="delivered"
                  onclick="updateOrderStatus(
                    ${order.id},
                    'delivered'
                  )"
                >
                  ✓ Delivered
                </button>
              `
              : ""
          }


          ${
            status !== "delivered" &&
            status !== "cancelled"
              ? `
                <button
                  class="cancel"
                  onclick="cancelOrder(
                    ${order.id}
                  )"
                >
                  Cancel
                </button>
              `
              : ""
          }


          ${
            cleanPhone
              ? `
                <a
                  class="call"
                  href="tel:+${cleanPhone}"
                >
                  📞 Call
                </a>

                <a
                  class="whatsapp"
                  href="https://wa.me/${cleanPhone}"
                  target="_blank"
                >
                  WhatsApp
                </a>
              `
              : ""
          }

        </div>

      </div>

    `;
  }


  /* =====================================
     UPDATE STATUS
  ===================================== */

  async function updateOrderStatus(
    orderId,
    newStatus
  ) {

    const confirmed =
      confirm(
        "Change order #" +
        orderId +
        " to " +
        formatStatus(
          newStatus
        ) +
        "?"
      );


    if (!confirmed) {
      return;
    }


    const {
      error
    } =
      await supabaseClient
        .from("orders")
        .update({
          order_status:
            newStatus
        })
        .eq(
          "id",
          orderId
        )
        .eq(
          "restaurant_id",
          currentRestaurantId
        );


    if (error) {

      console.error(
        error
      );

      alert(
        "Unable to update order:\n\n" +
        error.message
      );

      return;
    }


    await loadOrders();
  }


  /* =====================================
     CANCEL ORDER
  ===================================== */

  async function cancelOrder(
    orderId
  ) {

    const confirmed =
      confirm(
        "Are you sure you want to cancel order #" +
        orderId +
        "?"
      );


    if (!confirmed) {
      return;
    }


    await updateOrderStatus(
      orderId,
      "cancelled"
    );
  }


  /* =====================================
     STATS
  ===================================== */

  function updateStats(
    orders
  ) {

    document.getElementById(
      "stats"
    ).style.display =
      "grid";


    const pending =
      orders.filter(
        order =>
          order.order_status ===
          "pending"
      ).length;


    const preparing =
      orders.filter(
        order =>
          order.order_status ===
          "preparing"
      ).length;


    const ready =
      orders.filter(
        order =>
          order.order_status ===
          "ready"
      ).length;


    const today =
      new Date();


    const todayCount =
      orders.filter(
        order => {

          if (!order.created_at) {
            return false;
          }

          const date =
            new Date(
              order.created_at
            );

          return (
            date.getFullYear() ===
              today.getFullYear() &&
            date.getMonth() ===
              today.getMonth() &&
            date.getDate() ===
              today.getDate()
          );

        }
      ).length;


    document.getElementById(
      "pendingCount"
    ).textContent =
      pending;


    document.getElementById(
      "preparingCount"
    ).textContent =
      preparing;


    document.getElementById(
      "readyCount"
    ).textContent =
      ready;


    document.getElementById(
      "todayCount"
    ).textContent =
      todayCount;
  }


  /* =====================================
     FORMAT STATUS
  ===================================== */

  function formatStatus(
    status
  ) {

    return String(
      status || ""
    )
      .replace(
        /_/g,
        " "
      )
      .replace(
        /\b\w/g,
        letter =>
          letter.toUpperCase()
      );
  }


  /* =====================================
     FORMAT MONEY
  ===================================== */

  function formatMoney(
    amount
  ) {

    return Number(
      amount || 0
    ).toLocaleString(
      "en-KE"
    );
  }


  /* =====================================
     ESCAPE HTML
  ===================================== */

  function escapeHtml(
    value
  ) {

    return String(
      value ?? ""
    )
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );
  }


  /* =====================================
     AUTO REFRESH
     
     Check for new orders every
     15 seconds.
  ===================================== */

  setInterval(
    () => {

      if (
        currentRestaurantId
      ) {

        loadOrders();

      }

    },
    15000
  );

</script>

